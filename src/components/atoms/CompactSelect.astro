---
interface Option {
  disabled?: boolean;
  label: string;
  selected?: boolean;
  value: string;
}

interface Props {
  ariaLabel: string;
  disabled?: boolean;
  id?: string;
  name?: string;
  options: Option[];
  value?: string;
}

const { ariaLabel, disabled = false, id, name, options, value } = Astro.props;

const selectedOption =
  options.find((option) => option.value === value && !option.disabled) ??
  options.find((option) => option.selected && !option.disabled) ??
  options.find((option) => !option.disabled);

if (!selectedOption) {
  throw new Error("CompactSelect requires at least one enabled option.");
}

const controlId = id ?? `compact-select-${crypto.randomUUID()}`;
const listboxId = `${controlId}-listbox`;
const anchorName = `--${controlId}-anchor`;
---

<div
  class="compact-select"
  data-compact-select
  style={`--compact-select-anchor: ${anchorName}`}
>
  {name && <input name={name} type="hidden" value={selectedOption.value} />}
  <button
    aria-controls={listboxId}
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label={ariaLabel}
    class="compact-select__trigger"
    disabled={disabled}
    id={controlId}
    type="button"
  >
    <span data-select-label>{selectedOption.label}</span>
    <svg aria-hidden="true" class="compact-select__icon" viewBox="0 0 16 16">
      <path
        d="m4 6 4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></path>
    </svg>
  </button>
  <div
    aria-labelledby={controlId}
    class="compact-select__menu"
    id={listboxId}
    role="listbox"
    hidden
  >
    {
      options.map((option) => (
        <button
          aria-selected={
            option.value === selectedOption.value ? "true" : "false"
          }
          class:list={[
            "compact-select__option",
            { "is-selected": option.value === selectedOption.value },
          ]}
          data-label={option.label}
          data-value={option.value}
          disabled={option.disabled}
          role="option"
          type="button"
        >
          <span>{option.label}</span>
          <svg
            aria-hidden="true"
            class="compact-select__check"
            viewBox="0 0 16 16"
          >
            <path
              d="m3 8 3 3 7-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </button>
      ))
    }
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-compact-select]");

  for (const root of roots) {
    const trigger = root.querySelector<HTMLButtonElement>(
      ".compact-select__trigger",
    );
    const menu = root.querySelector<HTMLElement>(".compact-select__menu");
    const label = root.querySelector<HTMLElement>("[data-select-label]");
    const input = root.querySelector<HTMLInputElement>('input[type="hidden"]');

    if (!trigger || !menu || !label) continue;

    const enabledOptions = () =>
      Array.from(
        menu.querySelectorAll<HTMLButtonElement>(
          ".compact-select__option:not(:disabled)",
        ),
      );

    const close = (returnFocus = false) => {
      menu.hidden = true;
      root.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");

      if (returnFocus) trigger.focus();
    };

    const open = (index?: number) => {
      if (trigger.disabled) return;

      menu.hidden = false;
      root.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");

      const options = enabledOptions();
      const selectedIndex = options.findIndex(
        (option) => option.getAttribute("aria-selected") === "true",
      );
      options[index ?? Math.max(selectedIndex, 0)]?.focus();
    };

    const select = (option: HTMLButtonElement, returnFocus = true) => {
      const value = option.dataset.value;
      const optionLabel = option.dataset.label;

      if (!value || !optionLabel) return;

      for (const item of enabledOptions()) {
        const selected = item === option;
        item.classList.toggle("is-selected", selected);
        item.setAttribute("aria-selected", String(selected));
      }

      label.textContent = optionLabel;
      if (input) {
        input.value = value;
        input.dispatchEvent(new Event("change", { bubbles: true }));
      }

      root.dispatchEvent(
        new CustomEvent("compact-select:change", {
          bubbles: true,
          detail: { label: optionLabel, value },
        }),
      );

      close(returnFocus);
    };

    trigger.addEventListener("click", () => {
      if (menu.hidden) open();
      else close();
    });

    trigger.addEventListener("keydown", (event) => {
      const options = enabledOptions();

      if (event.key === "ArrowDown") {
        event.preventDefault();
        open(0);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        open(options.length - 1);
      } else if (event.key === "Escape") {
        close();
      }
    });

    menu.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLButtonElement>(
        ".compact-select__option",
      );

      if (option && !option.disabled) select(option);
    });

    menu.addEventListener("keydown", (event) => {
      const option = (event.target as Element).closest<HTMLButtonElement>(
        ".compact-select__option",
      );
      const options = enabledOptions();
      const index = option ? options.indexOf(option) : -1;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        options[(index + 1) % options.length]?.focus();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        options[(index - 1 + options.length) % options.length]?.focus();
      } else if (event.key === "Home") {
        event.preventDefault();
        options[0]?.focus();
      } else if (event.key === "End") {
        event.preventDefault();
        options.at(-1)?.focus();
      } else if (event.key === "Escape") {
        event.preventDefault();
        close(true);
      } else if (event.key === "Tab") {
        close();
      }
    });

    root.addEventListener("compact-select:select", (event) => {
      if (!(event instanceof CustomEvent)) return;

      const value = event.detail?.value;
      if (typeof value !== "string") return;

      const option = enabledOptions().find(
        (item) => item.dataset.value === value,
      );
      if (option) select(option, false);
    });

    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) close();
    });
  }
</script>

<style>
  .compact-select {
    position: relative;
    display: inline-block;
  }

  .compact-select__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-block-size: var(--control-size-default);
    padding-inline: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    anchor-name: var(--compact-select-anchor);
  }

  .compact-select__icon,
  .compact-select__check {
    flex: 0 0 auto;
    inline-size: var(--icon-size-select);
    block-size: var(--icon-size-select);
  }

  .compact-select__icon {
    color: var(--color-text-muted);
  }

  .compact-select__trigger:focus-visible,
  .compact-select.is-open .compact-select__trigger {
    outline-color: var(--color-accent);
    outline-offset: 0;
  }

  .compact-select.is-open .compact-select__icon {
    color: var(--color-accent);
    rotate: 180deg;
  }

  .compact-select__trigger:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .compact-select__menu {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + var(--space-xs));
    inset-inline-start: 0;
    display: grid;
    inline-size: var(--select-menu-inline-size);
    padding: var(--space-3xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-overlay);
  }

  @supports (position-anchor: --compact-select-anchor) {
    .compact-select__menu {
      position-anchor: var(--compact-select-anchor);
      inset-block-start: anchor(block-end);
      inset-inline-start: anchor(inline-start);
      position-try-fallbacks: flip-block;
    }
  }

  .compact-select__menu[hidden] {
    display: none;
  }

  .compact-select__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: var(--select-option-block-size);
    padding-inline: var(--space-sm);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--font-size-ui);
    font-weight: var(--font-weight-regular);
    text-align: start;
  }

  .compact-select__option.is-selected {
    background: var(--color-surface-raised);
    font-weight: var(--font-weight-semibold);
  }

  .compact-select__option:not(.is-selected):not(:disabled):hover {
    background: var(--color-surface-menu-hover);
  }

  .compact-select__option:focus-visible {
    outline-color: var(--color-accent);
    outline-offset: 0;
  }

  .compact-select__option:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .compact-select__check {
    color: var(--color-accent);
    opacity: 0;
  }

  .compact-select__option.is-selected .compact-select__check {
    opacity: 1;
  }
</style>
