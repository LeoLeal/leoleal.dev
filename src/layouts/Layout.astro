---
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  menuShowSearch?: boolean;
}

const {
  title,
  description,
  lang = "en-GB",
  menuShowSearch = true,
} = Astro.props;
const hasMenuLeading = Astro.slots.has("menu-leading");
const hasMenuNavigation = Astro.slots.has("menu-navigation");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&family=Newsreader:wght@400&display=swap"
    />
    {description && <meta name="description" content={description} />}
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="site-canvas">
      <Menu lang={lang} showSearch={menuShowSearch}>
        {hasMenuLeading && <slot name="menu-leading" slot="leading" />}
        {hasMenuNavigation && <slot name="menu-navigation" slot="navigation" />}
      </Menu>
      <slot name="hero" />
      <slot name="main" />
      <Footer />
    </div>
  </body>
</html>
